; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Judo Technique Visualizer"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/branding/icon.png"
boot_splash/bg_color=Color(0.7, 0.125, 0.165, 1)
boot_splash/image="res://assets/branding/splash.png"
boot_splash/fullsize=true

[dotnet]

project/assembly_name="JudoVisualizer"
